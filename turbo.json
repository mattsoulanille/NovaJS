{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!README.md",
                "!design/**",
                "!visual_compare/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "interruptible": true,
            "dependsOn": [
                "build"
            ]
        }
    }
}