    "test": "jasmine --config=jasmine.json"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.13",
    "@types/node": "^24.9.2",
    "jasmine": "^5.12.0",
    "rimraf": "^5.0.5",
    "typescript": "5.9.3"
  }
}
