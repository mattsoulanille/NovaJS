{
  "name": "novaparse",
  "version": "0.1.0",
  "description": "Parser for EV Nova files",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/nova_parse.js",
  "exports": {
    ".": {
      "types": "./dist/src/nova_parse.d.ts",
      "default": "./dist/src/nova_parse.js"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "jasmine --config=jasmine.json"
  },
  "dependencies": {
    "novadatainterface": "^0.1.6",
    "pngjs": "^7.0.0",
    "resource_fork": "^0.1.0",
    "ts-enum-util": "^4.0.2"
  },
  "devDependencies": {
    "@evn/tsconfig": "0.1.0",
    "@types/jasmine": "^5.1.13",
    "@types/node": "^24.9.2",
    "@types/pngjs": "^6.0.1",
    "jasmine": "^5.12.0",
    "rimraf": "^5.0.5",
    "typescript": "5.9.3"
  }
}
